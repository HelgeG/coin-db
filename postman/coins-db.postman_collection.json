{
  "info": {
    "name": "coins-db API",
    "description": "REST API for coins-db (coins_server). Ordered flow: create a coin, read it, add an estimate and link, check the summary, verify validation, then delete. Uses {{base_url}} and passes the created id via {{coin_id}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create coin",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{base_url}}/coins", "host": ["{{base_url}}"], "path": ["coins"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"country\": \"Norway\",\n  \"year_from\": 1963,\n  \"year_to\": 1963,\n  \"denomination\": \"50 Øre\",\n  \"currency\": \"NOK\",\n  \"face_value\": 50,\n  \"face_unit\": \"øre\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('country is a localized lookup ref', () => { pm.expect(body.country).to.be.an('object'); pm.expect(body.country.name).to.eql('Norway'); pm.expect(body.country.code).to.eql('NO'); });",
              "pm.test('currency + face unit resolved', () => { pm.expect(body.currency.code).to.eql('NOK'); pm.expect(body.face_unit.name).to.eql('øre'); });",
              "pm.test('assigned an id', () => pm.expect(body.id).to.be.above(0));",
              "pm.environment.set('coin_id', body.id);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get coin (with relations)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/coins/{{coin_id}}",
          "host": ["{{base_url}}"],
          "path": ["coins", "{{coin_id}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('has value_estimates array', () => pm.expect(body.value_estimates).to.be.an('array'));",
              "pm.test('has reference_links array', () => pm.expect(body.reference_links).to.be.an('array'));",
              "pm.test('has images array', () => pm.expect(body.images).to.be.an('array'));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "List coins",
      "request": {
        "method": "GET",
        "url": { "raw": "{{base_url}}/coins", "host": ["{{base_url}}"], "path": ["coins"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('returns an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Add value estimate",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{base_url}}/coins/{{coin_id}}/estimates",
          "host": ["{{base_url}}"],
          "path": ["coins", "{{coin_id}}", "estimates"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount_eur\": 120.5,\n  \"estimated_at\": \"2026-01-01\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "pm.test('amount echoed', () => pm.expect(pm.response.json().amount_eur).to.eql(120.5));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Add reference link",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{base_url}}/coins/{{coin_id}}/links",
          "host": ["{{base_url}}"],
          "path": ["coins", "{{coin_id}}", "links"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"label\": \"Numista\",\n  \"url\": \"https://numista.com/x\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('status is 201', () => pm.response.to.have.status(201));"],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Summary",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/summary?type=by_country",
          "host": ["{{base_url}}"],
          "path": ["summary"],
          "query": [
            {
              "key": "type",
              "value": "by_country",
              "description": "by_country (default) | total_value | by_decade | by_grade | by_metal"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('has a coin count', () => pm.expect(body.coin_count).to.be.at.least(1));",
              "pm.test('total reflects the estimate', () => pm.expect(body.total_estimate_eur).to.be.at.least(120.5));",
              "pm.test('echoes the selected breakdown type', () => pm.expect(body.breakdown.type).to.eql('by_country'));",
              "pm.test('breakdown has buckets', () => pm.expect(body.breakdown.buckets).to.be.an('array'));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "List lookups (country, localized)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/lookups/country?lang=nb",
          "host": ["{{base_url}}"],
          "path": ["lookups", "country"],
          "query": [{ "key": "lang", "value": "nb", "description": "en | nb" }]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('is an array of {id,code,name}', () => { pm.expect(body).to.be.an('array'); pm.expect(body[0]).to.have.keys(['id','code','name']); });",
              "pm.test('Norway localized to Norge (nb)', () => pm.expect(body.some(e => e.code === 'NO' && e.name === 'Norge')).to.be.true);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Create/resolve lookup (denomination)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{base_url}}/lookups/denomination",
          "host": ["{{base_url}}"],
          "path": ["lookups", "denomination"]
        },
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Speciedaler\"\n}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200 or 201', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
              "const body = pm.response.json();",
              "pm.test('returns {id,code,name}', () => { pm.expect(body.id).to.be.above(0); pm.expect(body.name).to.eql('Speciedaler'); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "List currency units (NOK)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/lookups/currency",
          "host": ["{{base_url}}"],
          "path": ["lookups", "currency"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const currencies = pm.response.json();",
              "const nok = currencies.find(c => c.code === 'NOK');",
              "pm.test('NOK exists', () => pm.expect(nok).to.be.an('object'));",
              "pm.sendRequest({ url: pm.variables.replaceIn('{{base_url}}') + '/currencies/' + nok.id + '/units', method: 'GET' }, (err, res) => {",
              "  pm.test('units listed for NOK', () => { const units = res.json(); pm.expect(units).to.be.an('array'); pm.expect(units.some(u => u.name === 'øre')).to.be.true; });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Create coin - invalid (422)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{base_url}}/coins", "host": ["{{base_url}}"], "path": ["coins"] },
        "body": { "mode": "raw", "raw": "{}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 422', () => pm.response.to.have.status(422));",
              "pm.test('reports validation errors', () => pm.expect(pm.response.json().errors).to.be.an('array').that.is.not.empty);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Delete coin",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{base_url}}/coins/{{coin_id}}",
          "host": ["{{base_url}}"],
          "path": ["coins", "{{coin_id}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('status is 200', () => pm.response.to.have.status(200));"],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get deleted coin (404)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/coins/{{coin_id}}",
          "host": ["{{base_url}}"],
          "path": ["coins", "{{coin_id}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('status is 404', () => pm.response.to.have.status(404));"],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
